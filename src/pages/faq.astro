---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, FAQS } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`よくある質問｜${SITE.name}`}
  description="紹介コード・ポイ活のよくある質問6件。コードの入力場所、登録の条件、TikTokの注意点、楽天モバイルの申込方法、掲示板への投稿、ポケカツにリンクがない理由など。"
  canonicalPath="/faq/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <p class="breadcrumb"><a href="/mea-code-matome/">トップ</a> › よくある質問</p>
    <h1>よくある質問｜紹介コード・ポイ活の疑問</h1>
    {FAQS.map((f) => (
      <div class="faq-item">
        <h2>{f.q}</h2>
        <p>{f.a}</p>
      </div>
    ))}
    <p><a href="/mea-code-matome/">トップへ戻る →</a></p>
  </div>
</BaseLayout>
